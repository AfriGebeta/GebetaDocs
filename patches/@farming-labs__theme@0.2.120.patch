+	return `<div class="fd-ai-code-block fd-ai-install"><div class="fd-ai-code-header"><div class="fd-ai-install-tabs">${tabs}</div>${copyButton}</div><pre><code>${escapeHtml(`${installManagers[0][1]} ${packages}`)}</code></pre></div>`;
