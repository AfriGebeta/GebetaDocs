diff --git a/styles/ai.css b/styles/ai.css
index c3bff17a1cfd0d80526d14d9f6a0c3d606078904..7539f0b1935bfbefcd220d03596855579680719f 100644
--- a/styles/ai.css
+++ b/styles/ai.css
@@ -1593,3 +1593,36 @@
 .fd-ai-fm-trigger-btn:active {
   transform: scale(0.97);
 }
+
+/* Package-manager install tabs in AI answers (```package-install blocks) */
+.fd-ai-install-tabs {
+  display: flex;
+  gap: 2px;
+}
+
+.fd-ai-install-tab {
+  font-size: 12px;
+  font-family: var(--fd-font-mono, ui-monospace, monospace);
+  color: var(--color-fd-muted-foreground, #71717a);
+  background: transparent;
+  border: 0;
+  border-radius: var(--radius, 4px);
+  padding: 2px 10px;
+  cursor: pointer;
+}
+
+.fd-ai-install-tab:hover {
+  color: var(--color-fd-foreground, #e4e4e7);
+}
+
+.fd-ai-install-tab[data-active="true"] {
+  color: var(--color-fd-foreground, #e4e4e7);
+  background: var(--color-fd-background, #fff);
+  box-shadow: 0 0 0 1px var(--color-fd-border, rgba(0, 0, 0, 0.08));
+}
+
+.fd-ai-install code::before {
+  content: "$ ";
+  color: var(--color-fd-muted-foreground, #71717a);
+  user-select: none;
+}
